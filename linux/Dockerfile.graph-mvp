ARG BASE_IMAGE=debian:bookworm-slim
FROM ${BASE_IMAGE}

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /raveil
COPY raveil /raveil/raveil
COPY benchmarks/native /raveil/benchmarks/native
COPY tests /raveil/tests

RUN python3 -m unittest tests.test_graph_mvp -v

CMD ["python3", "-m", "raveil", "graph-mvp", "--family", "gemm_bias_relu", "--m", "17", "--n", "19", "--k", "13", "--output", "/tmp/raveil-graph-mvp-result.json"]
