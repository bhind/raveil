ARG BASE_IMAGE=debian:bookworm-slim
FROM ${BASE_IMAGE}

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /raveil
COPY tools/iree/requirements.lock /raveil/tools/iree/requirements.lock
RUN python3 -m pip install --break-system-packages --no-cache-dir --require-hashes --no-deps \
    -r /raveil/tools/iree/requirements.lock

COPY raveil /raveil/raveil
COPY benchmarks/native /raveil/benchmarks/native
COPY benchmarks/iree /raveil/benchmarks/iree
COPY tests /raveil/tests

RUN python3 -m unittest tests.test_iree_import tests.test_graph_mvp -v
RUN python3 -m raveil graph-mvp \
    --backend native \
    --import-manifest benchmarks/iree/gemm-8x8x8-i32-i64.import.json \
    --iree-compile /usr/local/bin/iree-compile \
    --output /tmp/raveil-iree-import-result.json

CMD ["python3", "-m", "raveil", "graph-mvp", "--backend", "native", "--import-manifest", "benchmarks/iree/gemm-8x8x8-i32-i64.import.json", "--iree-compile", "/usr/local/bin/iree-compile", "--output", "/tmp/raveil-iree-result.json"]
